---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Lab Notes">
  <!-- Navbar -->
  <div class="navbar bg-base-200 shadow-sm">
    <div class="navbar-start">
      <a class="btn btn-ghost text-xl font-bold" href={base}>🧪 Lab Notes</a>
    </div>
    <div class="navbar-center hidden lg:flex">
      <ul class="menu menu-horizontal px-1">
        <li><a href="#about">About</a></li>
        <li><a href="#features">Features</a></li>
      </ul>
    </div>
    <div class="navbar-end">
      <a
        href="https://github.com/sagreenxyz/lab-notes"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline btn-sm"
      >
        GitHub
      </a>
    </div>
  </div>

  <!-- Hero Section -->
  <div class="hero min-h-[70vh] bg-base-200">
    <div class="hero-content text-center">
      <div class="max-w-2xl">
        <div class="text-6xl mb-4">🧪</div>
        <h1 class="text-5xl font-bold">Lab Notes</h1>
        <p class="py-6 text-lg text-base-content/70">
          A personal space for experiments, ideas, and observations. Built with
          <strong>Astro</strong> and styled with <strong>DaisyUI</strong>.
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="#features" class="btn btn-primary">Explore</a>
          <a
            href="https://github.com/sagreenxyz/lab-notes"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            View Source
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Features Section -->
  <section id="features" class="py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-12">What's Inside</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card bg-base-200 shadow-md hover:shadow-lg transition-shadow">
          <div class="card-body items-center text-center">
            <div class="text-4xl mb-2">📝</div>
            <h3 class="card-title">Notes</h3>
            <p class="text-base-content/70">
              Capture thoughts, snippets, and findings from everyday experiments.
            </p>
          </div>
        </div>
        <div class="card bg-base-200 shadow-md hover:shadow-lg transition-shadow">
          <div class="card-body items-center text-center">
            <div class="text-4xl mb-2">⚗️</div>
            <h3 class="card-title">Experiments</h3>
            <p class="text-base-content/70">
              Try new technologies and document the results for future reference.
            </p>
          </div>
        </div>
        <div class="card bg-base-200 shadow-md hover:shadow-lg transition-shadow">
          <div class="card-body items-center text-center">
            <div class="text-4xl mb-2">💡</div>
            <h3 class="card-title">Ideas</h3>
            <p class="text-base-content/70">
              Collect inspiration and brainstorm new projects and solutions.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="py-20 px-4 bg-base-200">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-6">About This Site</h2>
      <p class="text-lg text-base-content/70 mb-8">
        Lab Notes is a lightweight, static site built with
        <a href="https://astro.build" class="link link-primary" target="_blank" rel="noopener noreferrer">Astro</a>
        and
        <a href="https://daisyui.com" class="link link-primary" target="_blank" rel="noopener noreferrer">DaisyUI</a>.
        It's deployed automatically to GitHub Pages on every push to the main branch.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <div class="badge badge-primary badge-lg">Astro</div>
        <div class="badge badge-secondary badge-lg">DaisyUI</div>
        <div class="badge badge-accent badge-lg">Tailwind CSS</div>
        <div class="badge badge-neutral badge-lg">GitHub Pages</div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer footer-center p-6 bg-base-300 text-base-content">
    <p>
      Built with ❤️ using <a href="https://astro.build" class="link" target="_blank" rel="noopener noreferrer">Astro</a>
      &amp;
      <a href="https://daisyui.com" class="link" target="_blank" rel="noopener noreferrer">DaisyUI</a>
    </p>
  </footer>
</Layout>
